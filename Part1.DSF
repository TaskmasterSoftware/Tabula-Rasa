/OBJ
;obj  starts  weight  c w  5 4 3 2 1 0 9 8 7 6 5 4 3 2 1 0  noun  adjective
/0      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    TORCH  _
/1      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    KEY  _
/2      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    ROPE  _
/3      CARRIED 1       _ _  _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _    KNIFE  _

/PRO 0 ;Main Location Loop
> _        _     AT 0              ; Starting game?
                PROCESS 6 ; Initialise
> _        _     WINAT 13 0              ; by default, we have a text window at the bottom of the screen
                #ifdef "splitModeOn" ; if split mode is on, we have to apply it
                #ifdef "cpc"
                #endif
                #endif
                WINDOW 1
                WINSIZE 25 127
> _        _     WINDOW 0              ; Graphic window
                CLEAR   fDarkF ; Assume it is light
                NOTZERO 0
                ABSENT  0
                SET     fDarkF ; Dark
> _        _     ZERO fDarkF
                PICTURE @fPlayer ; if there is a picture, load it
                DISPLAY 0
                SKIP $pictureOK
                ; if we got here, there is no picture, so we have to set the text window full screen
> _        _
                #ifdef "splitModeOn"
                #endif
                WINDOW 1
                WINAT 0 0 ; Full screen text window
                WINSIZE 25 127
                CLS
                $pictureOK
> _        _     WINDOW 1              ; text window
                NOTZERO fDarkF ; dark
                SYSMESS 0
> _        _     ZERO fDarkF
                DESC   @fPlayer
                ; Now call process 3 for events that can be added to the current location description or happen when entering a location.
> _        _     PROCESS 3
                ; and now we can start the main loop of the game, which is process 1.
> _        _     PROCESS 1
                ;------------------------------------------------------------------------------

/PRO 1
> _        _     PROCESS 4              ; Do process 2 stuff here
> _        _     PARSE 0              ; Get next LS from current buffer
                PROCESS 2 ; Failed cos of invalid or timeout
                REDO
> _        _     EQ fTurns 255              ; Max for one byte
                PLUS    fTurnsHi 1
                CLEAR   fTurns
                SKIP    1
> _        _     PLUS fTurns 1
> _        _     PROCESS 5              ; Do any commands
                ISDONE ; Done something
                REDO
> _        _     MOVE fPlayer              ; No so try to move player
                CLS
                RESTART ; Absolute jump to start process 0
> _        _     NEWTEXT
                LT      fVerb    14
                SYSMESS 7
                REDO
> _        _     SYSMESS 8
                REDO
                ;------------------------------------------------------------------------------

/PRO 2
> _        _     HASAT TIMEOUT
                SYSMESS 35
                DONE
> _        _     SYSMESS 6              ; I didn't understand
                ;------------------------------------------------------------------------------

/PRO 3 ;Old process 1. Note that both the response table and the old PAW
> _        _     NEWLINE
                ZERO fDarkF
                PROCESS 7
> _        _     NEWLINE
                ZERO    fDarkF ; Isn't dark
                LISTOBJ
                ;than the old system needed in Version 1, without accesss to DarkF
                ;> _       _     NEWLINE
                ;                ZERO    0               ;If it is light...
                ;                ABSENT  0               ;and the light source is absent...
                ;                LISTOBJ                 ;List the objects
                ;> _       _     PRESENT 0               ;If the light source is present...
                ;                LISTOBJ                 ;List the objects
                ;------------------------------------------------------------------------------

/PRO 4 ;Old process 2

/PRO 5 ;Command decoder
; @DAAD-AUTO-BARRIER-START
> N        _
                AT lInsideChurch
                NOTZERO fBarrier0end7w3Lock
                SYSMESS 113
                DONE
> W        _
                AT lRoadOutsideTheManor
                ZERO fBlockage1tcbmv4
                SYSMESS 124
                DONE
> E        _
                AT lManorLobby
                ZERO fBlockage1tcbmv4
                SYSMESS 124
                DONE
> S        _
                AT lRoadOutsideTheManor
                NOTZERO fBarrier18n832iLock
                SYSMESS 127
                DONE
> UNLOC    DOOR
                AT lInsideChurch
                ZERO fBarrier0end7w3Lock
                SYSMESS 121
                DONE
> UNLOC    DOOR
                AT lInsideChurch
                PRESENT 1
                CLEAR fBarrier0end7w3Lock
                SYSMESS 116
                DONE
> EXAMI    DOOR
                AT lInsideChurch
                NOTZERO 65
                SYSMESS 123
                DONE
> EXAMI    DOOR
                AT lVestry
                NOTZERO 65
                SYSMESS 123
                DONE
> EXAMI    DOOR
                AT lInsideChurch
                SYSMESS 122
                DONE
> EXAMI    DOOR
                AT lVestry
                SYSMESS 122
                DONE
> CUT      ROPE
                AT lRoadOutsideTheManor
                ZERO fBarrier18n832iLock
                SYSMESS 135
                DONE
> CUT      ROPE
                AT lRoadOutsideTheManor
                PRESENT 3
                PLACE 2 CARRIED
                CLEAR fBarrier18n832iLock
                SYSMESS 130
                DONE
> EXAMI    DOOR
                AT lRoadOutsideTheManor
                NOTZERO 67
                SYSMESS 137
                DONE
> EXAMI    DOOR
                AT lTheStables
                NOTZERO 67
                SYSMESS 137
                DONE
> EXAMI    DOOR
                AT lRoadOutsideTheManor
                SYSMESS 136
                DONE
> EXAMI    DOOR
                AT lTheStables
                SYSMESS 136
                DONE
; @DAAD-AUTO-BARRIER-END
> N        _     AT lRoadOutsideTheFarm
                MESSAGE "If you head North you will leave the village and in your heart you know you are not ready to do that yet."
                DONE
> I        _     SYSMESS 9
                LISTAT  CARRIED
                SYSMESS 10
                LISTAT  WORN
                DONE
> GET      ALL     DOALL HERE
> GET      _     AUTOG
                DONE
> DROP     ALL     DOALL CARRIED
> DROP     _     AUTOD
                DONE
> REMOVE   ALL     DOALL WORN
> REMOVE   _     AUTOR
                DONE
> WEAR     ALL     DOALL CARRIED
> WEAR     _     AUTOW
                DONE
> R        _     CLS
                RESTART
> Q        _     QUIT
                END
> Q        _     DONE              ; Not like QUIT on PAW
> SAVE     _     SAVE 0
                CLS
                RESTART
> LOAD     _     LOAD 0
                CLS
                RESTART
> RAMSA    _     RAMSAVE
                CLS
                RESTART
> RAMLO    _     RAMLOAD 255              ; Reload all flags
                CLS
                RESTART
> LOOK     _     CLS
                RESTART
                ;------------------------------------------------------------------------------

/PRO 6 ;Initialisation
> _        _
                WINDOW  0 ; Make window 0 be full screen, and clear it
                WINAT 0 0
                WINSIZE 25 128
                CLS
                WINDOW  1 ; Define text Window starting at line 14
                WINAT 14 0
                WINSIZE 25 128 ; Also maximum with and height
                WINDOW 0
                PICTURE 0
                DISPLAY 0
                SKIP $picture0OK
> _        _     WINDOW 1              ; if we get here, there is no picture for location 0, so we have to set the text window full screen
                WINAT 0 0
                WINSIZE 25 128
                #ifdef "splitModeOn" ; Disable split mode if so
                #endif
                $picture0OK
> _        _     WINDOW 1
                DESC    0 ; Intro text
                ANYKEY
                CLS
                SET   255
                $initLoop
> _        _     MINUS 255 1              ; Clear all flags
                NOTEQ   255  fGFlags ; but GFlags!!!
                CLEAR   @255
> _        _     NOTZERO 255
                SKIP    $initLoop
> _        _     RESET              ; Objects to initial locations / Flag 1
                LET     fStrength 10
                LET     fMaxCarr 4
                SET     fCPronounNoun
                SET     fCPronounAdject
                LET     fObjectsCarried   NUM_CARRIED
                GOTO    1 ; Go to first location

/PRO 7 ;Exit code based on Rockersuke triz2DAAD
> _        _     NOTZERO fDarkF
                SYSMESS 0
                NEWLINE
                DONE
> _        _     SYSMESS 70
                CLEAR fNumberOfExits
                LET fVerb 2
> _        _     COPYFF fPlayer fTempLocation
                MOVE fTempLocation
                COPYFF fVerb fTemporaryFlag
                PLUS fTemporaryFlag 70
                SYSMESS @fTemporaryFlag
                PLUS fNumberOfExits 1
> _        _     PLUS fVerb 1
                LT fVerb 14
                SKIP -2
> _        _     NOTZERO fNumberOfExits
                NEWLINE
                DONE
> _        _     SYSMESS 71

